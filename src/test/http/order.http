@baseUrl = http://localhost:8080
# 같은 이메일로 회원가입을 다시 실행하면 중복 오류가 납니다. 재테스트할 때 숫자만 바꿔주세요.
@email = order-customer-manual-001@example.com
@password = Password123!
@productId = 10001

### 주문 테스트용 회원가입
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "name": "홍길동",
  "phone": "010-1234-5678"
}

### 주문 테스트용 로그인
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.test("로그인 성공", function () {
        client.assert(response.status === 200, "로그인 응답 상태는 200이어야 합니다.");
        client.assert(response.body.data !== null, "로그인 응답 data가 있어야 합니다.");
        client.assert(response.body.data.accessToken !== null, "accessToken이 있어야 합니다.");
    });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 주문할 장바구니 상품 담기
POST {{baseUrl}}/api/carts/items
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "productId": {{productId}},
  "quantity": 2
}

> {%
    client.global.set("orderCartItemId", response.body.data.cartItemId);
%}

### 주문 생성 성공 - 선택한 장바구니 상품으로 주문/결제 대기 생성
POST {{baseUrl}}/api/orders
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "cartItemIds": [{{orderCartItemId}}],
  "usePointAmount": 0
}

> {%
    client.test("주문 생성 성공", function () {
        client.assert(response.status === 201, "응답 상태는 201이어야 합니다.");
        client.assert(response.body.data.orderStatus === "PAYMENT_PENDING", "주문 상태는 PAYMENT_PENDING이어야 합니다.");
        client.assert(response.body.data.paymentStatus === "PENDING", "결제 상태는 PENDING이어야 합니다.");
        client.assert(response.body.data.paymentType === "CARD", "포인트를 쓰지 않으면 CARD 결제 타입이어야 합니다.");
        client.assert(response.body.data.pgAmount === response.body.data.totalAmount, "PG 결제 금액은 주문 총액과 같아야 합니다.");
        client.assert(response.body.data.nextAction === "OPEN_PORTONE_PAYMENT", "PortOne 결제창을 열어야 합니다.");
        client.assert(response.body.data.portonePaymentId !== null, "portonePaymentId가 있어야 합니다.");
        client.assert(response.body.data.items.length === 1, "주문 상품은 1개여야 합니다.");
    });
%}

### 주문 생성 후 장바구니 조회 - 주문 생성 시점에는 장바구니가 비워지지 않아야 함
GET {{baseUrl}}/api/carts
Authorization: Bearer {{accessToken}}

> {%
    client.test("주문 생성 후에도 장바구니는 유지된다", function () {
        client.assert(response.status === 200, "응답 상태는 200이어야 합니다.");
        client.assert(response.body.data.items.length >= 1, "결제 완료 전에는 장바구니 상품이 남아 있어야 합니다.");
    });
%}

### 주문 생성 실패 - 포인트 잔액 부족
POST {{baseUrl}}/api/orders
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "cartItemIds": [{{orderCartItemId}}],
  "usePointAmount": 999999999
}

> {%
    client.test("포인트 잔액 부족이면 실패한다", function () {
        client.assert(response.status === 400, "응답 상태는 400이어야 합니다.");
        client.assert(response.body.code === "INSUFFICIENT_POINT", "INSUFFICIENT_POINT를 반환해야 합니다.");
    });
%}

### 주문 생성 실패 - 사용 포인트가 음수
POST {{baseUrl}}/api/orders
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "cartItemIds": [{{orderCartItemId}}],
  "usePointAmount": -1
}

### 주문 생성 실패 - 토큰 없음
POST {{baseUrl}}/api/orders
Content-Type: application/json

{
  "cartItemIds": [{{orderCartItemId}}],
  "usePointAmount": 0
}
