@baseUrl = http://localhost:8080
@email = sparta@nbcamp.com
@password = sparta1234

### 포인트 테스트용 더미 계정 로그인
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.test("로그인 성공", function () {
        client.assert(response.status === 200, "응답 상태는 200이어야 합니다.");
        client.assert(response.body.data !== null, "응답 data가 있어야 합니다.");
        client.assert(response.body.data.accessToken !== null, "accessToken이 있어야 합니다.");
    });
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 포인트 잔액 조회 성공
GET {{baseUrl}}/api/points/balance
Authorization: Bearer {{accessToken}}

> {%
    client.test("포인트 잔액 조회 성공", function () {
        client.assert(response.status === 200, "응답 상태는 200이어야 합니다.");
        client.assert(response.body.status === 200, "공통 응답 status는 200이어야 합니다.");
        client.assert(response.body.data.userId === 10001, "더미 회원 ID는 10001이어야 합니다.");
        client.assert(response.body.data.balance === 235, "더미 포인트 잔액은 235이어야 합니다.");
    });
%}

### 포인트 거래 내역 조회 성공
GET {{baseUrl}}/api/points/transactions?page=0&size=10
Authorization: Bearer {{accessToken}}

> {%
    client.test("포인트 거래 내역 조회 성공", function () {
        client.assert(response.status === 200, "응답 상태는 200이어야 합니다.");
        client.assert(Array.isArray(response.body.data.content), "content는 배열이어야 합니다.");
        client.assert(response.body.data.totalElements >= 1, "더미 포인트 거래 내역이 1건 이상 있어야 합니다.");
        client.assert(response.body.data.page === 0, "page는 0이어야 합니다.");
        client.assert(response.body.data.size === 10, "size는 10이어야 합니다.");
    });
%}

### 포인트 거래 내역 타입 필터 조회 성공
GET {{baseUrl}}/api/points/transactions?type=EARN&page=0&size=10
Authorization: Bearer {{accessToken}}

> {%
    client.test("포인트 거래 타입 필터 조회 성공", function () {
        client.assert(response.status === 200, "응답 상태는 200이어야 합니다.");
        client.assert(Array.isArray(response.body.data.content), "content는 배열이어야 합니다.");
        response.body.data.content.forEach(function (transaction) {
            client.assert(transaction.type === "EARN", "조회된 거래 타입은 EARN이어야 합니다.");
        });
    });
%}

### 포인트 거래 내역 조회 실패 - 잘못된 거래 타입
GET {{baseUrl}}/api/points/transactions?type=INVALID_TYPE&page=0&size=10
Authorization: Bearer {{accessToken}}

> {%
    client.test("잘못된 포인트 거래 타입이면 실패한다", function () {
        client.assert(response.status === 400, "응답 상태는 400이어야 합니다.");
        client.assert(response.body.code === "INVALID_ENUM_VALUE", "INVALID_ENUM_VALUE를 반환해야 합니다.");
    });
%}

### 포인트 거래 내역 조회 실패 - 잘못된 페이지 번호
GET {{baseUrl}}/api/points/transactions?page=-1&size=10
Authorization: Bearer {{accessToken}}

> {%
    client.test("잘못된 페이지 번호이면 실패한다", function () {
        client.assert(response.status === 400, "응답 상태는 400이어야 합니다.");
        client.assert(response.body.code === "INVALID_PAGINATION", "INVALID_PAGINATION을 반환해야 합니다.");
    });
%}

### 포인트 잔액 조회 실패 - 토큰 없음
GET {{baseUrl}}/api/points/balance

> {%
    client.test("토큰이 없으면 인증 실패한다", function () {
        client.assert(response.status === 401, "응답 상태는 401이어야 합니다.");
        client.assert(response.body.code === "UNAUTHORIZED", "UNAUTHORIZED를 반환해야 합니다.");
    });
%}
